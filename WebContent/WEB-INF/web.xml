<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Post Job Servlet -->
    <servlet>
        <servlet-name>PostJobServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.PostJobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostJobServlet</servlet-name>
        <url-pattern>/PostJobServlet</url-pattern>
    </servlet-mapping>

    <!-- Job List Servlet -->
    <servlet>
        <servlet-name>JobListServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.JobListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JobListServlet</servlet-name>
        <url-pattern>/JobListServlet</url-pattern>
    </servlet-mapping>

    <!-- Apply Job Servlet -->
    <servlet>
        <servlet-name>ApplyJobServlet</servlet-name>
        <servlet-class>com.jobportal.servlet.ApplyJobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplyJobServlet</servlet-name>
        <url-pattern>/ApplyJobServlet</url-pattern>
    </servlet-mapping>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
